graph FoxAndHoundsArthur {
    layout=dot;
    rankdir=TB;
    nodesep=0.6;
    ranksep=0.7;

    node [shape=circle, style=filled, fillcolor="#f5f5f5", color="#757575", fontname="Helvetica", width=0.8, fixedsize=true];
    edge [color="#b71c1c", penwidth=1.6];

    // --- Ряды вершин (строго слева направо внутри каждого rank) ---

    // Ряд 0: Дом лисы
    { rank=same;
        C0 [label="🦊 C0", shape=square, fillcolor="#ffcc80", color="#e65100", penwidth=2.5];
    }

    // Ряд 1: Поляна перед мостом (строго L1 - C1 - R1)
    { rank=same;
        L1 [label="L1", fillcolor="#cfd8dc"];
        C1 [label="C1", fillcolor="#a5d6a7"];
        R1 [label="R1", fillcolor="#ffcdd2"];
        L1 -- C1 -- R1 [style=invis, weight=10];
    }

    // Ряд 2: Вход на мост и боковые узлы (строго L2 - C2 - R2)
    { rank=same;
        L2 [label="L2", fillcolor="#90caf9"];
        C2 [label="C2", fillcolor="#ffe082", color="#f57f17", penwidth=1.8];
        R2 [label="R2", fillcolor="#80cbc4"];
        L2 -- C2 -- R2 [style=invis, weight=10];
    }

    // Ряд 3: Выход с моста (правый берег)
    { rank=same;
        C3 [label="C3", fillcolor="#dce775"];
    }

    // Ряд 4: Развилка за мостом (строго L4 - C4 - R4)
    { rank=same;
        L4 [label="L4", fillcolor="#f8bbd0"];
        C4 [label="C4", fillcolor="#b0bec5"];
        R4 [label="R4", fillcolor="#d7ccc8"];
        L4 -- C4 -- R4 [style=invis, weight=10];
    }

    // Ряд 5: Узлы манёвра (строго L5 - C5 - R5)
    { rank=same;
        L5 [label="L5", fillcolor="#e1bee7"];
        C5 [label="C5", fillcolor="#ef9a9a"];
        R5 [label="R5", fillcolor="#a5d6a7"];
        L5 -- C5 -- R5 [style=invis, weight=10];
    }

    // Ряд 6: Промежуточный узел манёвра
    { rank=same;
        C6 [label="C6", fillcolor="#90caf9"];
    }

    // Ряд 7: Стартовые позиции собак (строго L7 - C7 - R7)
    { rank=same;
        L7 [label="🐶 L7", shape=doublecircle, fillcolor="#ffab91", color="#d84315", penwidth=2.0];
        C7 [label="🐶 C7", shape=doublecircle, fillcolor="#80cbc4", color="#00695c", penwidth=2.0];
        R7 [label="🐶 R7", shape=doublecircle, fillcolor="#9fa8da", color="#283593", penwidth=2.0];
        L7 -- C7 -- R7 [style=invis, weight=10];
    }

    // Ряд 8: Курятник (цель лисы)
    { rank=same;
        C8 [label="🐔 C8", shape=doublecircle, fillcolor="#fff59d", color="#b71c1c", penwidth=2.5];
    }

    // --- Центральная ось (удерживает симметрию по вертикали) ---
    C0 -- C1 [weight=5];
    C1 -- C2 [weight=5];
    C2 -- C3 [weight=5];
    C3 -- C4 [weight=5];
    C4 -- C5 [weight=5];
    C5 -- C6 [weight=5];
    C6 -- C7 [weight=5];
    C7 -- C8 [weight=5];

    // --- Боковые связи ---

    // 0 -> 1
    C0 -- L1;
    C0 -- R1;

    // Ряды 1 и 2
    L1 -- L2;
    R1 -- R2;
    L1 -- C1;
    R1 -- C1;

    // Сходы с ряда 1 и 2 в узел перед мостом (C2)
    L1 -- C2;
    R1 -- C2;
    L2 -- C2;
    R2 -- C2;

    // 3 -> 4 (выход с моста)
    C3 -- L4;
    C3 -- R4;

    // Внутри ряда 4
    L4 -- C4 -- R4;

    // 4 -> 5
    L4 -- L5;
    C4 -- L5;
    C4 -- R5;

    // Внутри ряда 5
    L5 -- C5 -- R5;

    // 5 -> 6 и выходы на собак
    L5 -- L7;
    R5 -- R7;
    L5 -- C6;
    R5 -- C6;

    // 6 -> Собаки
    C6 -- L7;
    C6 -- R7;

    // Горизонтальные связи собак
    L7 -- C7 -- R7;

    // 7 -> Курятник
    L7 -- C8;
    R7 -- C8;
}
